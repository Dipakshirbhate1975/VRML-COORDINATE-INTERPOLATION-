#VRML V2.0 utf8
WorldInfo {
 title "YELLOW FLAT ANIMATION USING CORDINATE INTERPOLATOR BY DR DIPAK SHIRBHATE"
 info ["This Web3D Content was created with Vivaty Studio, a Web3D authoring tool"
 "www.mediamachines.com"
 "This Web3D Content was created with Vivaty Studio, a Web3D authoring tool"]
}
## Vizthumbnail  Thumb_Untitled21_wrl4321241589477673.jpg
DEF Import_coint_wrl Group {
 children [
  DEF Box1 Shape {
   appearance Appearance {
    material DEF Yellow Material {
     ambientIntensity 0.200
     shininess 0.200
     diffuseColor 1 1 0
    }
   }
   geometry DEF Box1_Geo IndexedFaceSet {
    creaseAngle 0.524
    coordIndex [
      0 1 2 -1 
      0 2 3 -1 
      1 5 6 -1 
      1 6 2 -1 
      2 6 7 -1 
      2 7 3 -1 
      3 7 4 -1 
      3 4 0 -1 
      0 4 5 -1 
      0 5 1 -1 
      6 5 4 -1 
      6 4 7 -1 
    ]
    coord DEF Box1_Coord Coordinate {
     point [
      -1 1 0
      -1 1 0
      1 1 0
      1 1 0
      -1 -1 0
      -1 -1 0
      1 -1 0
      1 -1 0
     ]
    }
   }
  }
  DEF ci CoordinateInterpolator {
   key [
   0 .5 1
   ]
   keyValue [
   -1 -1 0
   1 -1 0
   1 1 0
   -1 1 0
   -1 -.5 0
   1 -.5 0
   1 .5 0
   -1 .5 0
   -1 -1 0
   1 -1 0
   1 1 0
   -1 1 0
   ]
  }
  DEF t TimeSensor {
   cycleInterval 2.000
   loop TRUE
   startTime -1.000
  }
 ]
}
DEF vizx_init TimeSensor {
 cycleInterval 0.100
 loop TRUE
}
ROUTE vizx_init.cycleTime TO t.startTime
ROUTE vizx_init.cycleTime TO vizx_init.stopTime
ROUTE t.fraction_changed TO ci.set_fraction
ROUTE ci.value_changed TO Box1_Coord.set_point
